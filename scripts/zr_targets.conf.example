# Targets for so_data, so_data_full and download_zr.sh.
# Copy to zr_targets.conf and fill in.
#
# zr_targets.conf is not in git: it is the only place that names hosts and
# directories, so nothing operational leaks into the repository. Credentials
# stay where they already are, in the gitignored scripts/passwords.
#
# Both values honour an environment override, so a test run can point the
# scripts somewhere else without editing this file.

# Directory the generated files are published into (the web root that serves
# them). Publishing is atomic, so this must be on the same filesystem as the
# files themselves.
ZR_WWW=${ZR_WWW:-/srv/www/CHANGEME/rose}

# sftp server the input feeds are fetched from. The account and password for
# it are USERNAME_ZUR / PASSWORD_ZUR in scripts/passwords.
ZR_DOMAIN=${ZR_DOMAIN:-sftp.example.com}
